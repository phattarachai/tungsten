<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Http\Request;
use Override;
use Phattarachai\Tungsten\Page;

class {{ class }} extends Page
{
    public function path(): string
    {
        return '{{ path }}';
    }

    public function component(): string
    {
        return '{{ component }}';
    }

