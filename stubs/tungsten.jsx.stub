import '../css/tungsten.css'

import { createTungstenApp } from '@tungsten'

// Pages are named relative to resources/js/pages (e.g. `panel/orders/Index`), the way Page::component() returns them.
// Add the lucide icons your nav uses beyond the kit's set with registerIcons({ 'icon-name': Icon }) from '@tungsten'.
createTungstenApp({
    pages: import.meta.glob('./pages/panel/**/*.jsx'),
})
