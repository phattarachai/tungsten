includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src

    checkModelProperties: true

    ignoreErrors:
        # InteractsWithTwoFactor is for the app's user model; the package's own code never uses it (the tests do).
        - identifier: trait.unused
